# ZX Bank RAG Application - Docker Environment Configuration
# Copy this file to .env and fill in your values.
# Do NOT commit .env — it is gitignored.

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=qwen3:4b
EMBEDDING_MODEL=qwen3-embedding:4b

# Qwen3 reasoning settings
LLM_REASONING=true
LLM_NUM_CTX=16384
LLM_NUM_PREDICT=3072
LLM_TEMPERATURE=0.3

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=zx_bank_knowledge

# Dataset
DATASET_PATH=dataset/ZX Bank

# Chunking
CHUNK_SIZE=1600
CHUNK_OVERLAP=200

# Retrieval
RETRIEVAL_STRATEGY=hybrid
RETRIEVAL_K=8
RETRIEVAL_FETCH_K=40
RETRIEVAL_KEYWORD_WEIGHT=0.35
RETRIEVAL_EXPAND_NEIGHBORS=true
RETRIEVAL_MAX_PER_TITLE=3

# Application
APP_ENV=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8080
