# ZX Bank RAG Application Configuration

# Copy this file to .env and fill in your values.
# Do NOT commit .env — it is gitignored.

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:4b
EMBEDDING_MODEL=qwen3-embedding:4b

# Qwen3 reasoning settings
# Keep LLM_REASONING=true: this Ollama build leaks chain-of-thought into the
# answer when thinking is disabled. num_ctx/num_predict must be large enough
# for the reasoning + final answer, otherwise answers come back empty.
LLM_REASONING=true
LLM_NUM_CTX=16384
LLM_NUM_PREDICT=3072
LLM_TEMPERATURE=0.3

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=zx_bank_knowledge

# Dataset
DATASET_PATH=dataset/ZX Bank

# Chunking. Larger chunks keep headings, tables and their numbers together.
CHUNK_SIZE=1600
CHUNK_OVERLAP=200

# Retrieval
# hybrid = dense vector search + BM25 keyword search, merged and deduplicated.
RETRIEVAL_STRATEGY=hybrid
RETRIEVAL_K=8
RETRIEVAL_FETCH_K=40
RETRIEVAL_KEYWORD_WEIGHT=0.35
RETRIEVAL_EXPAND_NEIGHBORS=true
RETRIEVAL_MAX_PER_TITLE=3
